# Copy to backend/.env (the backend also reads ../.env). Never commit real keys.

# oracle = offline demo (replays ground-truth extraction from the synthetic dataset; no API calls)
# openai | groq = real model extraction
AI_PROVIDER=oracle

GROQ_API_KEY=your-groq-key-here
OPENAI_API_KEY=your-openai-key-here

# Defaults verified against provider docs on 2026-10-20; override freely.
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-6.1-sol

# Optional: on timeout/429/5xx/auth/quota errors, retry once on this provider (recorded in usage as fallback_from).
# FALLBACK_PROVIDER=openai

LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# Generate LLM explanations/drafts (numbers are checked against facts; template used otherwise)
LLM_NARRATIVES=true

DATABASE_URL=sqlite:///./tripsignal.db
# Fix "today" for reproducible demos (deadline countdowns)
AS_OF_DATE=2026-10-20
CORS_ORIGINS=http://localhost:3000
